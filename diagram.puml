@startuml FilmNow - LAB03
!theme plain
skinparam backgroundColor #1E1E2E
skinparam class {
  BackgroundColor #313244
  ArrowColor #89B4FA
  BorderColor #89B4FA
  FontColor #CDD6F4
  HeaderBackgroundColor #1E1E2E
  StereotypeFontColor #A6ADC8
}
skinparam title {
  FontColor #CDD6F4
  FontSize 18
}
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho

title FilmNow - LAB03 (Modo Escuro)

class FilmNow {
  - filmes: Filme[100]
  - hotList: HotList
  - scanner: Scanner
  --
  + FilmNow()
  + executar(): void
  + exibirMenu(): void
  + adicionarFilme(): void
  + mostrarTodos(): void
  + detalharFilme(): void
  + exibirHotList(): void
  + atribuirHot(): void
  + removerHot(): void
}

class Filme {
  - nome: String
  - ano: String
  - local: String
  --
  + Filme(nome: String, ano: String, local: String)
  + getNome(): String
  + getAno(): String
  + getLocal(): String
  + equals(obj: Object): boolean
  + hashCode(): int
  + toString(): String
}

class HotList {
  - filmes: Filme[10]
  --
  + HotList()
  + adicionar(filme: Filme, posicao: int): void
  + remover(posicao: int): void
  + contem(filme: Filme): boolean
  + listar(): String
}

FilmNow *-- "100" Filme
FilmNow *-- "1" HotList
HotList o-- "10" Filme

@enduml
